---
interface Props {
  title: string;
  tagline?: string;
}
const { title, tagline } = Astro.props;

// Astro.url.pathname includes the base path; BASE_URL does too. Build hrefs
// through withBase so the site works both at the root (Cloudflare Pages) and
// under /<repo>/ (GitHub Pages).
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${BASE}${p}`;

const nav = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/about/'), label: 'About' },
  { href: withBase('/projects/'), label: 'Projects' },
  { href: withBase('/contact/'), label: 'Contact' },
];
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Rocky Land Group (prototype)</title>
      <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <div class="banner">
      Prototype — placeholder content, not the real Rocky Land Group site.
    </div>

    <header>
      <a class="wordmark" href={withBase('/')}>Rocky Land Group</a>
      <nav>
        {
          nav.map((n) => (
            <a href={n.href} aria-current={here === n.href ? 'page' : undefined}>
              {n.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <h1>{title}</h1>
      {tagline && <p class="tagline">{tagline}</p>}
      <slot />
    </main>

    <footer>
      <p>Rocky Land Group — prototype build. Content is editable at <a href={withBase('/admin/')}>/admin</a>.</p>
    </footer>

    <style is:global>
      :root {
        --ink: #23201c;
        --muted: #6b635a;
        --rule: #ddd6cc;
        --paper: #faf8f5;
        --accent: #7a5c3e;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font: 17px/1.65 ui-serif, Georgia, 'Times New Roman', serif;
      }
      .banner {
        background: #7a5c3e;
        color: #fff;
        font: 600 13px/1 ui-sans-serif, system-ui, sans-serif;
        letter-spacing: 0.02em;
        padding: 9px 20px;
        text-align: center;
      }
      header {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 28px;
        align-items: baseline;
        justify-content: space-between;
        max-width: 760px;
        margin: 0 auto;
        padding: 28px 20px 18px;
        border-bottom: 1px solid var(--rule);
      }
      .wordmark {
        font: 600 20px/1 ui-sans-serif, system-ui, sans-serif;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
      }
      nav { display: flex; gap: 20px; }
      nav a {
        font: 15px/1 ui-sans-serif, system-ui, sans-serif;
        color: var(--muted);
        text-decoration: none;
      }
      nav a[aria-current='page'] { color: var(--accent); font-weight: 600; }
      nav a:hover { color: var(--ink); }
      main { max-width: 760px; margin: 0 auto; padding: 36px 20px 8px; }
      h1 { font-size: 2.1rem; line-height: 1.15; margin: 0 0 8px; }
      h2 { font-size: 1.3rem; margin: 2em 0 0.4em; }
      .tagline { color: var(--muted); font-size: 1.15rem; margin: 0 0 28px; }
      blockquote {
        margin: 2em 0;
        padding: 12px 18px;
        border-left: 3px solid var(--rule);
        color: var(--muted);
        font-size: 0.95rem;
      }
      a { color: var(--accent); }
      footer {
        max-width: 760px;
        margin: 48px auto 0;
        padding: 18px 20px 40px;
        border-top: 1px solid var(--rule);
        color: var(--muted);
        font: 14px/1.6 ui-sans-serif, system-ui, sans-serif;
      }
      .cards { display: grid; gap: 18px; margin: 28px 0 0; padding: 0; list-style: none; }
      .card {
        border: 1px solid var(--rule);
        border-radius: 6px;
        padding: 18px 20px;
        background: #fff;
      }
      .card h2 { margin: 0 0 4px; font-size: 1.2rem; }
      .card h2 a { text-decoration: none; }
      .meta {
        font: 13px/1.5 ui-sans-serif, system-ui, sans-serif;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .card p { margin: 8px 0 0; }
      img { max-width: 100%; height: auto; border-radius: 4px; }
    </style>
  </body>
</html>

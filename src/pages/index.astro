---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(entry);
// Sveltia writes image paths as site-absolute (/media/x.jpg). Prefix the base
// so they resolve when the site is served under a subpath.
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const hero = entry.data.hero ? `${BASE}${entry.data.hero}` : undefined;
---

<Base title="Rocky Land Group" tagline={entry.data.tagline}>
  {hero && <img src={hero} alt="" />}
  <Content />
</Base>

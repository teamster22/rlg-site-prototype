---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return pages
    .filter((p) => p.id !== 'home')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
// Sveltia writes image paths as site-absolute (/media/x.jpg); add the base.
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const hero = entry.data.hero ? `${BASE}${entry.data.hero}` : undefined;
---

<Base title={entry.data.title} tagline={entry.data.tagline}>
  {hero && <img src={hero} alt="" />}
  <Content />
</Base>
